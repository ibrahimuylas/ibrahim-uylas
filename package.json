{
  "name": "elegantstack",
  "private": true,
  "license": "",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/**",
    "site"
  ],
  "scripts": {
    "test": "node --test packages/flow-ui/flow-ui-widgets/src/Post/createDisqusConfig.test.cjs packages/plugins/gatsby-remark-unwrap-video/index.test.cjs netlify/functions/instagram-feed.test.cjs",
    "build": "npm run build -w site",
    "validate:html": "npm run validate:html -w site",
    "validate:seo": "npm run validate:seo:likya -w site",
    "check:deps": "npm ls --depth=0",
    "check:deps:all": "npm ls --all",
    "audit:prod": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "decap-cms-app": "3.6.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
