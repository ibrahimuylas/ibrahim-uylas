# Optional client-side Algolia search settings
GATSBY_ALGOLIA_APP_ID=
GATSBY_ALGOLIA_SEARCH_KEY=
GATSBY_ALGOLIA_INDEX_NAME=Posts

# Server-only indexing credential. Configure it in the hosting provider; never
# expose it through a GATSBY_ variable or commit a real value here.
ALGOLIA_ADMIN_KEY=

# Google Analytics 4 measurement ID (Admin > Data streams > Web)
GATSBY_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only Instagram feed settings (configure in Netlify; never prefix with GATSBY_)
# Keep the access token secret. This placeholder is intentionally unusable.
INSTAGRAM_ACCESS_TOKEN=replace-with-secret-in-netlify
# Numeric professional Instagram account ID (not the public @username)
INSTAGRAM_USER_ID=00000000000000000
# Explicit Graph API version used by the server-side function
INSTAGRAM_API_VERSION=v00.0
