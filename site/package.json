{
  "name": "@elegantstack/gatsby-starter-flexiblog-agency",
  "private": true,
  "version": "4.0.0",
  "scripts": {
    "develop": "gatsby develop",
    "develop:likya-preview": "GATSBY_LIKYA_GUIDE_PREVIEW=true gatsby develop",
    "start": "gatsby clean && gatsby develop",
    "build": "npm run build:gatsby && npm run build:sanitize && npm run build:index",
    "build:gatsby": "GATSBY_CPU_COUNT=${GATSBY_CPU_COUNT:-2} gatsby build",
    "build:sanitize": "node scripts/sanitize-generated-html.js",
    "build:index": "pagefind --site public --glob '**/index.html'",
    "clean": "gatsby clean",
    "serve": "gatsby serve",
    "validate:html": "node scripts/validate-generated-html.js",
    "validate:likya:data": "node scripts/validate-likya-data.js",
    "validate:likya:conditions": "node scripts/validate-likya-conditions.js",
    "validate:likya:freshness": "node scripts/validate-likya-conditions.js",
    "validate:likya:links": "node scripts/seo/validate-likya-canonicals.js",
    "validate:likya:release": "node scripts/validate-likya-release.js",
    "report:likya:research": "node scripts/report-likya-stage-research.js",
    "report:likya:research-board": "node scripts/report-likya-pafta-research-board.js",
    "report:likya:reconciliation": "node scripts/report-likya-pafta-reconciliation.js",
    "report:likya:review-packets": "node scripts/report-likya-pafta-review-packets.js",
    "report:likya:book-intake": "node scripts/report-likya-book-reference-intake.js",
    "report:likya:pafta-release": "node scripts/report-likya-pafta-publication-readiness.js",
    "report:likya:operational-evidence": "node scripts/report-likya-operational-evidence.js",
    "report:likya:route-metrics": "node scripts/report-likya-route-metrics.js",
    "report:likya:official-observations": "node scripts/report-likya-official-observations.js",
    "validate:seo:likya": "node scripts/seo/validate-likya-canonicals.js",
    "validate:seo:likya:http": "node scripts/seo/check-likya-http.js",
    "test:likya:data": "node --test src/content-guides/likya/validation.test.cjs",
    "test:likya:guide-shell": "node --test src/components/likyaGuideShellPolicy.test.cjs",
    "test:likya:recommendation": "node --test src/content-guides/likya/route-recommendation.test.cjs",
    "test:likya:planner": "node --test src/content-guides/likya/route-recommendation.test.cjs",
    "test:likya:atlas": "node --test src/content-guides/likya/route-atlas.test.cjs",
    "test:likya:stages": "node --test src/content-guides/likya/stage-guides.test.cjs",
    "test:likya:western": "node --test src/content-guides/likya/western-region.test.cjs",
    "test:likya:central": "node --test src/content-guides/likya/central-region.test.cjs",
    "test:likya:eastern": "node --test src/content-guides/likya/eastern-region.test.cjs",
    "test:likya:plans": "node --test src/content-guides/likya/route-plans.test.cjs",
    "test:likya:preparation": "node --test src/content-guides/likya/preparation-center.test.cjs",
    "test:likya:conditions": "node --test src/content-guides/likya/condition-status.test.cjs",
    "test:likya:release": "node --test src/content-guides/likya/release-readiness.test.cjs",
    "test:likya:research": "node --test src/content-guides/likya/stage-research.test.cjs",
    "test:likya:research-board": "node --test src/content-guides/likya/pafta-research-board.test.cjs",
    "test:likya:reconciliation": "node --test src/content-guides/likya/official-pafta-reconciliation.test.cjs",
    "test:likya:reconciliation-reviews": "node --test src/content-guides/likya/pafta-reconciliation-reviews.test.cjs",
    "test:likya:operational-evidence": "node --test src/content-guides/likya/stage-operational-evidence.test.cjs",
    "test:likya:route-metrics": "node --test src/content-guides/likya/stage-route-metrics.test.cjs",
    "test:likya:official-observations": "node --test src/content-guides/likya/official-pafta-observations.test.cjs",
    "test:likya:book-intake": "node --test src/content-guides/likya/book-reference-evidence.test.cjs",
    "test:likya:pafta-release": "node --test src/content-guides/likya/pafta-publication-readiness.test.cjs",
    "test:likya:pafta-pages": "node --test src/content-guides/likya/pafta-guide-pages.test.cjs"
  },
  "dependencies": {
    "@elegantstack/gatsby-theme-flexiblog-agency": "*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@marsidev/react-turnstile": "1.5.5",
    "@mdx-js/react": "^2.3.0",
    "dotenv": "^17.4.2",
    "gatsby": "^5.16.1",
    "gatsby-plugin-decap-cms": "^4.0.4",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "pagefind": "1.5.2",
    "prettier": "^3.9.6"
  }
}
