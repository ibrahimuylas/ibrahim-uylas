{
  "name": "@elegantstack/gatsby-starter-flexiblog-agency",
  "private": true,
  "version": "4.0.0",
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby clean && gatsby develop",
    "build": "npm run build:gatsby && npm run build:sanitize && npm run build:index",
    "build:gatsby": "GATSBY_CPU_COUNT=${GATSBY_CPU_COUNT:-2} gatsby build",
    "build:sanitize": "node scripts/sanitize-generated-html.js",
    "build:index": "pagefind --site public",
    "clean": "gatsby clean",
    "serve": "gatsby serve",
    "validate:html": "node scripts/validate-generated-html.js",
    "validate:seo:likya": "node scripts/seo/validate-likya-canonicals.js",
    "validate:seo:likya:http": "node scripts/seo/check-likya-http.js"
  },
  "dependencies": {
    "@elegantstack/gatsby-theme-flexiblog-agency": "*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@marsidev/react-turnstile": "1.5.5",
    "@mdx-js/react": "^2.3.0",
    "dotenv": "^17.4.2",
    "gatsby": "^5.16.1",
    "gatsby-plugin-decap-cms": "^4.0.4",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "pagefind": "1.5.2",
    "prettier": "^3.9.6"
  }
}
